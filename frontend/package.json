{
  "name": "errandflow",
  "version": "0.0.0",
  "scripts": {
    "nx": "nx",
    "start": "nx serve errandflow",
    "start:open": "nx serve errandflow --open",
    "build": "nx build errandflow --configuration=production",
    "build:dev": "nx build errandflow --configuration=development",
    "build:watch": "nx build errandflow --configuration=development --watch",
    "test": "nx test errandflow",
    "test:ci": "nx test errandflow --watch=false",
    "test:coverage": "nx test errandflow --watch=false --coverage",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "check": "npm run lint && npm run test:ci && npm run build",
    "api:snapshot": "curl -kfsS https://localhost:7094/openapi/v1.json -o openapi/errandflow.json",
    "api:generate": "ng-openapi-gen --config ng-openapi-gen.json",
    "api:update": "npm run api:snapshot && npm run api:generate"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.5",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@auth0/auth0-angular": "^2.15.0",
    "@jsverse/transloco": "^8.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.5",
    "@angular-devkit/schematics": "^22.2.5",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@nx/angular": "24.0.4",
    "@nx/eslint": "^24.0.4",
    "@nx/eslint-plugin": "^24.0.4",
    "@nx/workspace": "24.0.4",
    "@schematics/angular": "^22.2.5",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.8.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "^1.1.0",
    "nx": "24.0.4",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
